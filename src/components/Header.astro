---
import { url } from '../lib/url';
const links = [
	{ href: '/', label: 'home' },
	{ href: '/blog/', label: 'blog' },
	{ href: '/blog/resources/', label: 'resources' },
	{ href: '/blog/knowledge/', label: 'knowledge' },
	{ href: '/blog/thoughts/', label: 'thoughts' },
	{ href: '/blog/ctf/', label: 'ctf writeup' },
	{ href: '/blog/friends/', label: 'friends' },
	{ href: '/blog/comments/', label: 'comments' },
	{ href: '/about/', label: 'about' },
];

const pathname = Astro.url.pathname;
// Compare against the base-prefixed href: under a `base`, Astro.url.pathname
// already includes it, so comparing with the bare href never matches.
const isActive = (href: string) =>
	href === '/' ? pathname === url('/') : pathname.startsWith(url(href));
---

<header class="site-header">
	<div class="site-header-inner">
		<a href={url('/')} class="pixel-title site-brand">YIXUAN</a>
		<nav class="site-nav" aria-label="Primary navigation">
			{links.map((link) => <a class:list={{ active: isActive(link.href) }} href={url(link.href)}>[{link.label}]</a>)}
		</nav>
	</div>
</header>
