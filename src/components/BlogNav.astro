---
import { url } from '../lib/url';
const sections = [
	{ href: '/blog/', label: 'posts' },
	{ href: '/blog/resources/', label: 'resources' },
	{ href: '/blog/knowledge/', label: 'knowledge' },
	{ href: '/blog/thoughts/', label: 'thoughts' },
	{ href: '/blog/ctf/', label: 'ctf writeup' },
	{ href: '/blog/friends/', label: 'friends' },
	{ href: '/blog/comments/', label: 'comments' },
];
const pathname = Astro.url.pathname;
---

<nav class="blog-nav" aria-label="Blog navigation">
	{sections.map((section) => {
		const href = url(section.href);
		return (
			<a class:list={{ active: section.href === '/blog/' ? pathname === href : pathname.startsWith(href) }} href={href}>[{section.label}]</a>
		);
	})}
</nav>
